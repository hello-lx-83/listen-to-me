{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Listen to Me",
  "version": "0.1.1",
  "identifier": "com.hello.listen-to-me",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Listen to Me",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "visible": false,
        "backgroundColor": "#17130f"
      },
      {
        "label": "splashscreen",
        "title": "Listen to Me",
        "url": "splashscreen.html",
        "width": 340,
        "height": 190,
        "center": true,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#17130f"
      },
      {
        "label": "voice-overlay",
        "title": "Voice Input",
        "width": 420,
        "height": 72,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "homepage": "https://github.com/hello-lx-83/listen-to-me",
    "shortDescription": "按住说话，松开输入。",
    "longDescription": "一款面向 Windows 的桌面语音输入工具，可将语音识别、整理后写入当前输入框。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
